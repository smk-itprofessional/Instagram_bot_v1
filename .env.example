# Copy to .env (local) or GitHub Secrets (automation). Never commit real tokens.
IG_USER_ID=
IG_ACCESS_TOKEN=
# DRY_RUN=true = just generate image+caption locally, don't post. Auto-true if creds empty.
DRY_RUN=true
IG_API_VERSION=v21.0
# Optional: skip free upload if you already host the image
# IMAGE_URL_OVERRIDE=https://...
# Optional paid-free-tier fallbacks (only if catbox fails):
# IMGBB_API_KEY=
# CLOUDINARY_URL=
